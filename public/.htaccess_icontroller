# iDAS firmware upload limits (Apache mod_php only).
# Guarded with IfModule so PHP-FPM/CGI deployments ignore these directives safely.
<IfModule mod_php.c>
    php_value upload_max_filesize 512M
    php_value post_max_size 550M
    php_value max_input_time 600
    php_value max_execution_time 600
</IfModule>
<IfModule php_module>
    php_value upload_max_filesize 512M
    php_value post_max_size 550M
    php_value max_input_time 600
    php_value max_execution_time 600
</IfModule>
